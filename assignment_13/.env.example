# Local PostgreSQL configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=devops_db

# Connection URL for Local DB (via Docker Compose):
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@db:5432/devops_db

# Connection URL for AWS RDS PostgreSQL:
# Format: postgresql+asyncpg://<username>:<password>@<aws-rds-endpoint>:5432/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:your_password@your-rds-endpoint.us-east-1.rds.amazonaws.com:5432/postgres

# SSL Configuration for AWS (optional: require / disable)
DB_SSL_MODE=require
SQL_ECHO=false
